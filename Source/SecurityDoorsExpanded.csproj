<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <ProjectGuid>{512163F6-FC37-4C53-8F4A-476B681B5FCE}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>SecurityDoorsExpanded</RootNamespace>
    <AssemblyName>SecurityDoorsExpanded</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
    <ModRoot Condition="'$(ModRoot)' == ''">$(MSBuildProjectDirectory)/../</ModRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <GameVersion>1.6</GameVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <GameVersion>1.7</GameVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SecurityClearance">
      <HintPath>..\..\..\references\SecurityClearance\Assemblies\SecurityClearance.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.5000-unstable" />
    <PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.4" />
  </ItemGroup>

  <Target Name="CopyToModAssemblies" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModRoot)$(GameVersion)/Assemblies/" />
  </Target>
</Project>
