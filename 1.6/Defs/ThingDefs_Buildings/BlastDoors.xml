<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="SDE_DoorSmallBase">
    <defName>SDE_ArmoredSecurityDoorSmall</defName>
    <label>blast door (1x1)</label>
    <description>A heavily armored, blast-resistant door. It's expensive, slow to open, and requires electricity, but can take a tremendous amount of punishment before failing.</description>
    <graphicData>
      <texPath>Things/Building/BlastDoor_Small/BlastDoor_Small_Underlayer_Mover</texPath>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconPath>Things/Building/BlastDoor_Small/BlastDoor_Small_MenuIcon_south</uiIconPath>
    <building>
      <blueprintGraphicData>
        <texPath>Things/Building/BlastDoor_Small/BlastDoor_Small_MenuIcon</texPath>
      </blueprintGraphicData>
      <doorTopGraphic>
        <texPath>Things/Building/BlastDoor_Small/BlastDoor_Small_Top</texPath>
      </doorTopGraphic>
      <doorSupportGraphic>
        <texPath>Things/Building/BlastDoor/BlastDoor_Support_Atlas</texPath>
        <graphicClass>SecurityDoorsExpanded.Graphic_LinkedSupport</graphicClass>
        <drawSize>(2, 2)</drawSize>
        <linkFlags>
          <li>Wall</li>
          <li>Rock</li>
        </linkFlags>
      </doorSupportGraphic>
      <upperMoverGraphic>
        <texPath>Things/Building/BlastDoor_Small/BlastDoor_Small_Upper_Mover</texPath>
      </upperMoverGraphic>
      <unpoweredDoorOpenSpeedFactor>1</unpoweredDoorOpenSpeedFactor>
      <unpoweredDoorCloseSpeedFactor>1</unpoweredDoorCloseSpeedFactor>
    </building>
    <statBases>
      <WorkToBuild>5200</WorkToBuild>
      <MaxHitPoints>1260</MaxHitPoints>
    </statBases>
    <damageMultipliers>
      <li>
        <damageDef>Bomb</damageDef>
        <multiplier>0.05</multiplier>
      </li>
      <li>
        <damageDef>Thump</damageDef>
        <multiplier>0.05</multiplier>
      </li>
    </damageMultipliers>
    <researchPrerequisites>
      <li>SDE_ArmoredSecurityDoors</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <uiOrder>2019</uiOrder>
    <costStuffCount>75</costStuffCount>
    <costList>
      <ComponentIndustrial>4</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <modExtensions>
      <li Class="SecurityDoorsExpanded.DefModExtension_DoorShutter"/>
      <li Class="SecurityDoorsExpanded.DefModExtension_DoorArrows">
        <normal>(0,255,0)</normal>
        <checkpoint>(255,202,0)</checkpoint>
        <lockdown>(255,0,0)</lockdown>
      </li>
    </modExtensions>
  </ThingDef>

