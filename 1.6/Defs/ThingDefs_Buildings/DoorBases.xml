  </ThingDef>

  <ThingDef ParentName="SDE_VacDoorBase" Name="SDE_DoorLargeBase" Abstract="True">
    <size>(3, 1)</size>
    <building>
      <blueprintGraphicData>
        <drawSize>(4.90, 4.90)</drawSize>
      </blueprintGraphicData>
      <doorTopGraphic>
        <drawSize>(4, 2)</drawSize>
      </doorTopGraphic>
      <doorSupportGraphic>
        <drawSize>(4, 2)</drawSize>
      </doorSupportGraphic>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>75</basePowerConsumption>
      </li>
      <li Class="SecurityDoorsExpanded.CompProperties_DoorBanners">
        <lockdown>
          <texPath>Things/Building/HoloBanner_Large/HoloBanner_Large_Lockdown</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <shaderType>TransparentPostLight</shaderType>
          <drawSize>(3, 1)</drawSize>
        </lockdown>
        <checkpoint>
          <texPath>Things/Building/HoloBanner_Large/HoloBanner_Large_Checkpoint</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <shaderType>TransparentPostLight</shaderType>
          <drawSize>(3, 1)</drawSize>
        </checkpoint>
      </li>
      <li MayRequire="Ludeon.RimWorld.Odyssey" Class="SecurityDoorsExpanded.CompProperties_VacCheckpoint"/>
      <li MayRequire="Ludeon.RimWorld.Odyssey" Class="SecurityDoorsExpanded.CompProperties_VacDoor">
        <panelCost>4</panelCost>
        <barrierPowerDraw>90</barrierPowerDraw>
        <barrierGraphicData>
          <texPath>Things/Building/VacBarrier_Large/VacBarrier_Large</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <shaderType>TransparentPostLight</shaderType>
          <drawSize>(4, 2)</drawSize>
          <color>(142,142,142)</color>
        </barrierGraphicData>
      </li>
    </comps>
  </ThingDef>
  
  <ThingDef ParentName="SDE_VacDoorBase" Name="SDE_DoorVehicleBase" Abstract="True">
    <thingClass>SecurityDoorsExpanded.Building_VehicleDoor</thingClass>
    <size>(5, 1)</size>
    <building>
      <blueprintGraphicData>
        <drawSize>(5.97, 5.97)</drawSize>
      </blueprintGraphicData>
      <doorTopGraphic>
        <drawSize>(6, 2)</drawSize>
      </doorTopGraphic>
      <doorSupportGraphic>
        <drawSize>(6, 2)</drawSize>
      </doorSupportGraphic>
      <poweredDoorOpenSpeedFactor>3</poweredDoorOpenSpeedFactor>
      <poweredDoorCloseSpeedFactor>3</poweredDoorCloseSpeedFactor>
      <unpoweredDoorOpenSpeedFactor>1</unpoweredDoorOpenSpeedFactor>
      <unpoweredDoorCloseSpeedFactor>1</unpoweredDoorCloseSpeedFactor>
    </building>
    <modExtensions>
      <li Class="SecurityDoorsExpanded.DefModExtension_VehicleDoor">
        <blockerDef>SDE_VehicleDoorBlocker</blockerDef>
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>110</basePowerConsumption>
      </li>
      <li Class="SecurityDoorsExpanded.CompProperties_DoorBanners">
        <lockdown>
          <texPath>Things/Building/HoloBanner_Vehicle/HoloBanner_Vehicle_Lockdown</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <shaderType>TransparentPostLight</shaderType>
          <drawSize>(5, 1)</drawSize>
        </lockdown>
        <checkpoint>
          <texPath>Things/Building/HoloBanner_Vehicle/HoloBanner_Vehicle_Checkpoint</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <shaderType>TransparentPostLight</shaderType>
          <drawSize>(5, 1)</drawSize>
        </checkpoint>
      </li>
      <li MayRequire="Ludeon.RimWorld.Odyssey" Class="SecurityDoorsExpanded.CompProperties_VacDoor">
        <panelCost>6</panelCost>
        <barrierPowerDraw>120</barrierPowerDraw>
        <barrierGraphicData>
          <texPath>Things/Building/VacBarrier_Vehicle/VacBarrier_Vehicle</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <shaderType>TransparentPostLight</shaderType>
          <drawSize>(6, 2)</drawSize>
          <color>(142,142,142)</color>
        </barrierGraphicData>
      </li>
    </comps>
  </ThingDef>

</Defs>
