<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="SDE_DoorSmallBase">
    <defName>SDE_SecurityDoorSmall</defName>
    <label>security door (1x1)</label>
    <description>A heavily reinforced door. It's slow to open and requires electricity, but is very strong. It's a good choice if you want to keep something dangerous out - or in.</description>
    <graphicData>
      <texPath>Things/Building/SecurityDoor_Small/SecurityDoor_Small_Underlayer_Mover</texPath>
    </graphicData>
    <uiIconPath>Things/Building/SecurityDoor_Small/SecurityDoor_Small_MenuIcon_south</uiIconPath>
    <building>
      <blueprintGraphicData>
        <texPath>Things/Building/SecurityDoor_Small/SecurityDoor_Small_MenuIcon</texPath>
      </blueprintGraphicData>
      <doorTopGraphic>
        <texPath>Things/Building/SecurityDoor_Small/SecurityDoor_Small_Top</texPath>
        <drawSize>(2.25, 2.4)</drawSize>
      </doorTopGraphic>
      <doorSupportGraphic>
        <texPath>Things/Building/SecurityDoor_Small/SecurityDoor_Small_Support</texPath>
        <drawSize>(2.25, 2.4)</drawSize>
      </doorSupportGraphic>
      <upperMoverGraphic>
        <texPath>Things/Building/SecurityDoor_Small/SecurityDoor_Small_Upper_Mover</texPath>
      </upperMoverGraphic>
    </building>
    <statBases>
      <WorkToBuild>2300</WorkToBuild>
      <MaxHitPoints>255</MaxHitPoints>
    </statBases>
    <researchPrerequisites>
      <li>SecurityDoor</li>
    </researchPrerequisites>
    <uiOrder>2016</uiOrder>
    <costStuffCount>25</costStuffCount>
    <costList>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
  </ThingDef>

